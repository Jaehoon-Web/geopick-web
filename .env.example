# ─────────────────────────────────────────────
# 지오픽 공식 사이트 — 환경변수 템플릿
# Railway 배포 시 Variables 탭에서 등록하세요.
# ─────────────────────────────────────────────

# ── A. Slack 웹훅 알림 (가장 빠른 옵션 · 5분 셋업) ─────────────
# https://api.slack.com/apps → 새 앱 → Incoming Webhooks 활성화
# → "Add New Webhook to Workspace" → 채널 선택 → URL 발급
SLACK_WEBHOOK_URL=

# ── B. Resend 이메일 알림 (Resend SaaS · 10분 셋업) ───────────
# https://resend.com → API Keys → "Create API Key"
# 도메인 검증 후 LEAD_FROM_EMAIL 사용 가능
RESEND_API_KEY=
LEAD_NOTIFY_EMAIL=lead@geopick.kr
LEAD_FROM_EMAIL=no-reply@geopick.kr

# ── C. 카카오톡 알림톡 (Solapi 게이트웨이 · 검수 1~3일) ────────
# 1) https://solapi.com 가입 + 발신번호 등록
# 2) 카카오톡 비즈채널 개설 + Solapi에 연동 → pfId 발급
# 3) 알림톡 템플릿 등록 + 카카오 검수
SOLAPI_API_KEY=
SOLAPI_API_SECRET=
SOLAPI_SENDER_PHONE=
SOLAPI_PF_ID=
SOLAPI_TEMPLATE_ID=
LEAD_NOTIFY_PHONE=

# ─────────────────────────────────────────────
# 권장 시작 순서:
#   1단계 (라이브 즉시):  Slack 웹훅 또는 Resend 이메일 채움
#   2단계 (1주차):        카톡 알림톡 검수 신청 + 통과 후 SOLAPI_* 채움
# 셋 중 하나만 채워도 폼 알림이 동작합니다.
# ─────────────────────────────────────────────
